# EchoMind 运行期开关（复制为 .env 后生效；改完需要 ./scripts/service.sh restart）

# 社交习惯化：off | shadow | on
#   off    = 不干预（默认）
#   shadow = 只计算并写日志，不改变行为
#   on     = 真正生效
ECHOMIND_SATIATION=off

# 思考通道：on | off（on = reasoning_content 与 content 分离）
ECHOMIND_THINKING=on

# 思考强度：low | high | max（仅 thinking=on 时有效）
ECHOMIND_REASONING_EFFORT=low
